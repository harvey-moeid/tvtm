# Salin ke .env untuk testing lokal (JANGAN commit .env asli).
# Di GitHub Actions, isi ini sebagai Repository Secrets, bukan file.

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Cloudflare D1 (dipakai langsung via REST API, tanpa Worker)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_DATABASE_ID=your_d1_database_id
CF_API_TOKEN=your_cloudflare_api_token_with_d1_edit_permission
